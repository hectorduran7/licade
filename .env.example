# ==================== CONFIGURACIÓN DE FIREBASE ====================
# Reemplaza los siguientes valores con las credenciales de tu proyecto de Firebase.
# Estas variables se usarán para inyectarse en config.js durante la compilación en Vercel.

FIREBASE_API_KEY=tu_api_key_aqui
FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu_proyecto_id
FIREBASE_STORAGE_BUCKET=tu_proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
FIREBASE_APP_ID=tu_app_id

# Clave pública del sitio de Google reCAPTCHA v3 para la activación de App Check
APP_CHECK_SITE_KEY=tu_site_key_de_recaptcha_aqui
